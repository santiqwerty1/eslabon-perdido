{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eslabon-perdido.local/schemas/issue.json",
  "title": "Issue",
  "description": "Pregunta, contradicción o dato pendiente. Apéndice E.12. Destino obligatorio del conocimiento general (§4.7) y de todo WARNING no justificado (§19.1).",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/issue_id"
    },
    "issue_type": {
      "type": "string",
      "enum": [
        "unresolved_identity",
        "missing_source",
        "conflicting_claims",
        "external_knowledge_flagged",
        "validation_warning",
        "pending_question",
        "schema_inconsistency",
        "content_gap"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "$ref": "common.json#/$defs/severity"
    },
    "raised_in": {
      "oneOf": [
        {
          "$ref": "common.json#/$defs/section_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "Sección que originó la cuestión, o null si no procede de una ingestión (p. ej. cuestiones de Fase 0). No se usan identificadores centinela inexistentes: romperían la integridad referencial."
    },
    "affects": {
      "type": "object",
      "properties": {
        "record_ids": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/id"
          }
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CLAIM-[0-9]{6}$"
          }
        },
        "mention_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^MENTION-[0-9]{6}$"
          }
        }
      },
      "required": [
        "record_ids",
        "claim_ids",
        "mention_ids"
      ],
      "additionalProperties": false
    },
    "evidence_locators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_resolution": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocks": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_issue_ids": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/issue_id"
      }
    },
    "resolution": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "wont_fix"
          ]
        },
        "resolved_in": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "record_status": {
      "$ref": "common.json#/$defs/record_status"
    }
  },
  "required": [
    "id",
    "issue_type",
    "title",
    "severity",
    "raised_in",
    "affects",
    "resolution",
    "record_status"
  ],
  "additionalProperties": false
}
