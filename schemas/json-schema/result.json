{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eslabon-perdido.local/schemas/result.json",
  "title": "Result",
  "description": "Resultado de un análisis (prefijo RESULT-, §16.3; fase mínima 3 en §8). Tercer eslabón de §6.4. Un resultado no es una afirmación: se convierte en evidencia de una afirmación mediante un EvidenceItem, y ese paso queda explícito para que un soporte estadístico no pase por conclusión.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RESULT-[0-9]{6}$"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^ANALYSIS-[0-9]{6}$",
      "description": "Análisis que lo produjo. Un resultado sin análisis identificable no es trazable."
    },
    "result_type": {
      "type": "string",
      "enum": [
        "topology",
        "network",
        "support_value",
        "divergence_time_estimate",
        "ancestral_state",
        "admixture_proportion",
        "distance",
        "model_fit",
        "date_estimate",
        "summary_statistic",
        "other"
      ]
    },
    "description": { "type": ["string", "null"] },
    "value": {
      "type": ["number", "string", "null"],
      "description": "Valor puntual cuando lo hay. Se conserva la expresión de la fuente si no es numérica."
    },
    "unit": { "type": ["string", "null"] },
    "scale": { "type": ["string", "null"] },
    "support": {
      "type": ["object", "null"],
      "description": "Soporte estadístico asociado. Escalas distintas no se comparan como si fueran una sola (§10.7).",
      "properties": {
        "measure_type": {
          "type": "string",
          "enum": [
            "bootstrap",
            "posterior_probability",
            "jackknife",
            "bremer",
            "p_value",
            "confidence_interval",
            "credible_interval",
            "other"
          ]
        },
        "value": { "type": ["number", "string"] },
        "scale": { "type": ["string", "null"] }
      },
      "required": ["measure_type", "value"],
      "additionalProperties": false
    },
    "topology": {
      "type": ["object", "null"],
      "description": "§15.3. El formato técnico definitivo queda ABIERTO hasta la fase de vistas; el registro admite los candidatos ya previstos.",
      "properties": {
        "format": {
          "type": "string",
          "enum": ["newick", "extended_newick", "clade_list", "event_graph", "claim_set"]
        },
        "content": { "type": ["string", "null"] },
        "content_path": { "type": ["string", "null"] },
        "content_hash": {
          "oneOf": [{ "$ref": "common.json#/$defs/content_hash" }, { "type": "null" }]
        }
      },
      "required": ["format"],
      "additionalProperties": false
    },
    "temporal_expression_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TIME-[0-9]{6}$" },
      "description": "Estimaciones temporales producidas por el análisis, con su incertidumbre (§11.2)."
    },
    "applies_to_ids": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/id" },
      "description": "Nodos o relaciones a los que se refiere el resultado."
    },
    "source_ids": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/source_id" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "issue_ids": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/issue_id" }
    },
    "provenance": { "$ref": "common.json#/$defs/provenance" },
    "notes": { "$ref": "common.json#/$defs/notes" },
    "record_status": { "$ref": "common.json#/$defs/record_status" }
  },
  "required": ["id", "analysis_id", "result_type", "provenance", "record_status"],
  "additionalProperties": false
}
